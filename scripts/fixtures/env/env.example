# Required
EXAMPLE_DOMAIN=chat.example.org
POSTGRES_PASSWORD=change-me

# Node
TAVRN_NAME=My node                 # shown in the directory
TAVRN_REGISTRATION=invite          # open | invite | closed
# Who may create rooms: see <docs> and https://example.org/rooms, or ask alice@example.org.
# TAVRN_ROOM_CREATION=invite

# Limits per remote domain and minute:
# TAVRN_RATE_A=60
# TAVRN_RATE_B=300

# Voice (protocol/VOICE.md). The node starts a media server; TAVRN_NAME names it.
#   TAVRN_VOICE_ENABLED=false
TAVRN_VOICE_ENABLED=true
# Addresses announced to clients: an IP address
# TAVRN_RTC_EXTERNAL_IP=203.0.113.7
# or a hostname, resolved every minute
# TAVRN_RTC_EXTERNAL_IP=home.example
TAVRN_LOG_LEVEL=info
