# Runtime configuration of the tavrn website container (deploy/docker-compose.yml). Copy to .env next to the
# compose file, or set the values in the Portainer stack. Every variable has a default; URLs without a trailing slash.

# Where "Open the web app" (/app) redirects to: the web app of the official node.
TAVRN_APP_URL=https://tavrn.swsp.eu

# The official node: the status page asks it for /healthz, /readyz and /api/v1/node, the status pill in the header
# of every page for /healthz (directly from the visitor's browser, so it is also allowed in the Content-Security-
# Policy's connect-src; the node answers with CORS *).
TAVRN_NODE_URL=https://tavrn.swsp.eu

# Its WebSocket endpoint for the delegation document. Empty: derived from TAVRN_NODE_URL (https -> wss, + /api/v1/ws).
TAVRN_NODE_WS_URL=

# The identity domain the delegation document names (addresses like alice@tavrn.org).
TAVRN_NODE_DOMAIN=tavrn.org

# /.well-known/tavrn: off (404), on (a static document built from the variables above) or proxy (forwarded to the
# node's own document, which includes its signing keys; what tavrn-node's handbook recommends for delegation).
TAVRN_WELLKNOWN=off

# Uptime Kuma (optional, see the commented service in docker-compose.yml): its base URL as this container reaches it
# (for example http://uptime-kuma:3001 on the shared network; it does not have to be public) and the slug of its
# public status page. The container forwards the two read-only API endpoints of that page as /uptime/api/status-page/…
# (Kuma sends no CORS headers, so the browser cannot ask it directly). With an https:// URL the status page also
# links to Kuma's own page. Both empty: the status page shows live checks only.
UPTIME_KUMA_URL=
UPTIME_KUMA_PAGE=

# The known-issues page (/issues) lists the open issues of the organization's repositories. The visitor's browser
# never contacts GitHub: it asks this container for /gh/issues, and the container runs one fixed issue search on
# GitHub's API with this token (no visitor headers, no query parameters of the visitor) and answers with the result,
# cacheable for five minutes. The token needs read access to issues only: a fine-grained personal access token or a
# GitHub App installation token with "Issues: read-only" (and the implied "Metadata: read-only") on the
# organization's repositories. It also makes the issues of private repositories visible on the page, which is
# intended while the project is in private review. Empty: /gh/issues is 404 and the page links to GitHub instead.
GITHUB_READ_TOKEN=

# The GitHub organization whose open issues the list shows (a name like just-tavrn; its URL works too). Keep it the
# same as the build-time PUBLIC_GITHUB_ORG, which the page's links to GitHub use.
GITHUB_ORG=just-tavrn
