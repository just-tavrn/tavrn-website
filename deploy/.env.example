# Runtime configuration of the tavrn website container (deploy/docker-compose.yml). Copy to .env next to the
# compose file, or set the values in the Portainer stack. Every variable has a default; URLs without a trailing slash.

# Where "Open the web app" (/app) redirects to: the web app of the official node.
TAVRN_APP_URL=https://app.tavrn.org

# The official node: the status page asks it for /healthz, /readyz and /api/v1/node, the status pill in the header
# of every page for /healthz (directly from the visitor's browser, so it is also allowed in the Content-Security-
# Policy's connect-src; the node answers with CORS *).
TAVRN_NODE_URL=https://app.tavrn.org

# Its WebSocket endpoint for the delegation document. Empty: derived from TAVRN_NODE_URL (https -> wss, + /api/v1/ws).
TAVRN_NODE_WS_URL=

# The identity domain the delegation document names (addresses like alice@tavrn.org).
TAVRN_NODE_DOMAIN=tavrn.org

# /.well-known/tavrn: off (404), on (a static document built from the variables above) or proxy (forwarded to the
# node's own document, which includes its signing keys; what tavrn-node's handbook recommends for delegation).
TAVRN_WELLKNOWN=off

# /.well-known/assetlinks.json for the Android app (org.tavrn.app, tavrn-web docs/ANDROID.md): the SHA-256 fingerprint
# of its release signing certificate (AA:BB:…, `keytool -list -v`). It makes tavrn.org's passkeys usable in the app
# and names the app for links. Empty: 404.
TAVRN_ANDROID_CERT_SHA256=

# Uptime Kuma (optional, see the commented service in docker-compose.yml): its base URL as this container reaches it
# (for example http://uptime-kuma:3001 on the shared network; it does not have to be public) and the slug of its
# public status page. The container forwards the two read-only API endpoints of that page as /uptime/api/status-page/…
# (Kuma sends no CORS headers, so the browser cannot ask it directly). With an https:// URL the status page also
# links to Kuma's own page. Both empty: the status page shows live checks only.
UPTIME_KUMA_URL=
UPTIME_KUMA_PAGE=

# The known-issues page (/issues) lists the open issues of the organization's repositories, the download page
# (/download) the newest releases of tavrn-web (installers) and tavrn-node (image tags). The visitor's browser never
# contacts GitHub: it asks this container for /gh/issues, /gh/releases/web, /gh/releases/node and /gh/repos/web, and
# the container makes the matching fixed request to GitHub's API with this token (no visitor headers, no query
# parameters of the visitor) and answers with the result, cacheable for five minutes, so a new release shows within
# five minutes without a new image. The installers are plain links to GitHub; the container never proxies a binary.
# The token needs read access only: a fine-grained personal access token or a GitHub App installation token with
# "Issues: read-only" and "Contents: read-only" (and the implied "Metadata: read-only") on the organization's
# repositories. It also makes the issues and releases of private repositories visible on the pages, which is
# intended while the project is in private review (the download page then lists the release without download
# buttons). Empty: /gh/* is 404, and both pages link to GitHub instead.
GITHUB_READ_TOKEN=

# The GitHub organization of the issues and of the tavrn-web and tavrn-node repositories (a name like just-tavrn;
# its URL works too). Keep it the same as the build-time PUBLIC_GITHUB_ORG, which the pages' links to GitHub use.
GITHUB_ORG=just-tavrn

# The imprint (/legal/imprint/) and the GDPR controller in the privacy policy (/legal/privacy/): the provider's name
# and postal address, and the contact address. Personal data: set them here or in the Portainer stack, never in a
# repository; the image contains none of it. Caddy writes them into exactly these two pages on every request (its
# templates handler, deploy/Caddyfile), so changing them needs a restart, not a new image. entrypoint.sh removes line
# breaks and HTML-escapes them. Unset: visible placeholders ("Name of the provider", …), and a warning in the log.
# The privacy policy also names the host of TAVRN_NODE_URL above.
TAVRN_IMPRINT_NAME=
TAVRN_IMPRINT_STREET=
TAVRN_IMPRINT_CITY=
TAVRN_IMPRINT_COUNTRY=Germany

# The contact address in the imprint and the privacy policy, also the target of their mailto: links. Only a plain
# address is accepted (letters, digits, . _ % + - and one @); anything else falls back to hello@tavrn.org.
TAVRN_CONTACT_EMAIL=hello@tavrn.org
