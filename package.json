{
  "name": "@tavrn/website",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "sync-docs": "node scripts/sync-docs.mjs",
    "fetch-releases": "node scripts/fetch-releases.mjs",
    "dev": "node scripts/sync-docs.mjs && astro dev --port 4321",
    "build": "node scripts/sync-docs.mjs && node scripts/fetch-releases.mjs && astro build && node scripts/csp-hashes.mjs",
    "preview": "astro preview --port 4400 --host 127.0.0.1",
    "typecheck": "node scripts/sync-docs.mjs && astro check",
    "test": "vitest run",
    "e2e": "playwright test -c e2e/playwright.config.ts --project chromium --project mobile-android --workers=2"
  },
  "packageManager": "pnpm@12.9.1",
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.2",
    "@astrojs/preact": "^6.0.6",
    "@astrojs/sitemap": "^3.7.4",
    "@astrojs/starlight": "^0.42.6",
    "@fontsource-variable/inter": "^5.3.0",
    "@lucide/astro": "^1.54.0",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.3.8",
    "mermaid": "^12.1.0",
    "preact": "^10.29.8",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "1.63.0",
    "@types/node": "^24.19.1",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3"
  }
}
