---
// SPDX-License-Identifier: Apache-2.0
import Site from "../layouts/Site.astro";
import { localePath, t } from "../i18n";

const locale = Astro.currentLocale;
---

<Site title={t(locale, "notfound.title")} noindex>
  <section class="container-site py-24 text-center md:py-32">
    <p class="text-sm font-semibold tracking-wide text-accent">404</p>
    <h1 class="mt-3 text-4xl font-bold tracking-tight text-fg-0">{t(locale, "notfound.title")}</h1>
    <p class="mt-4 text-lg text-fg-1">{t(locale, "notfound.lead")}</p>
    <div class="mt-8 flex flex-col justify-center gap-3 sm:flex-row">
      <a href={localePath(locale, "/")} class="btn btn-primary">{t(locale, "notfound.home")}</a>
      <a href={localePath(locale, "/docs/")} class="btn btn-secondary">{t(locale, "notfound.docs")}</a>
    </div>
  </section>
</Site>
