---
// SPDX-License-Identifier: Apache-2.0
// The download page: the desktop installers of the newest tavrn-web releases, read in the browser at runtime from the
// site's own GitHub proxies (Releases.astro, src/lib/releases.ts), the checksum verifier, the web app, and the
// container image for self-hosters. Without JavaScript a note links to the releases on GitHub; the web app and
// self-host cards are static.
import { PUBLIC_GITHUB_ORG } from "astro:env/client";
import Globe from "@lucide/astro/icons/globe";
import Server from "@lucide/astro/icons/server";
import Releases from "../components/download/Releases.astro";
import Verifier from "../components/download/Verifier.astro";
import Site from "../layouts/Site.astro";
import { escapeHtml, localePath, rich, t } from "../i18n";

const locale = Astro.currentLocale;
const nodeReleases = `https://github.com/${PUBLIC_GITHUB_ORG}/tavrn-node/releases`;
const nodeReleasesHtml = `<a class="link" href="${nodeReleases}" rel="noopener">${escapeHtml(t(locale, "download.selfhost.node_releases_link"))}<span class="sr-only">${escapeHtml(t(locale, "common.external"))}</span></a>`;
---

<Site title={t(locale, "download.title")} description={t(locale, "download.lead")}>
  <section class="container-site pt-16 pb-8 md:pt-24">
    <h1 class="text-4xl font-bold tracking-tight text-fg-0 md:text-5xl">{t(locale, "download.title")}</h1>
    <p class="mt-4 max-w-2xl text-lg text-fg-1" set:html={rich(locale, "download.lead")} />
    <p class="release-line mt-3 text-fg-2" aria-live="polite" data-release-line>{t(locale, "download.loading")}</p>
  </section>

  <Releases />

  <Verifier />

  <section class="container-site pb-20 md:pb-28">
    <div class="grid gap-4 md:grid-cols-2">
      <div class="side-card" data-web-card>
        <div class="flex items-center gap-3">
          <span class="side-icon" aria-hidden="true"><Globe class="h-5 w-5" /></span>
          <h2 class="text-xl font-semibold text-fg-0">{t(locale, "download.web.title")}</h2>
        </div>
        <p class="mt-3 text-fg-1">{t(locale, "download.web.text")}</p>
        <p class="mt-2 text-fg-1">{t(locale, "download.web.any_node")}</p>
        <p class="mt-auto pt-5"><a href="/app" class="btn btn-primary">{t(locale, "download.web.cta")}</a></p>
      </div>
      <div class="side-card" data-selfhost-card>
        <div class="flex items-center gap-3">
          <span class="side-icon" aria-hidden="true"><Server class="h-5 w-5" /></span>
          <h2 class="text-xl font-semibold text-fg-0">{t(locale, "download.selfhost.title")}</h2>
        </div>
        <p class="mt-3 text-fg-1">{t(locale, "download.selfhost.text")}</p>
        <p class="mt-4 text-sm font-medium text-fg-2" id="image-label">{t(locale, "download.selfhost.image_label")}</p>
        <pre class="image mt-1.5"><code translate="no" data-node-image>{`ghcr.io/${PUBLIC_GITHUB_ORG}/tavrn-node`}</code></pre>
        <p class="mt-2 text-sm text-fg-1" data-node-note set:html={rich(locale, "download.selfhost.node_static", { linkHtml: nodeReleasesHtml })} />
        <p class="mt-auto pt-5">
          <a href={localePath(locale, "/docs/admins/install/")} class="btn btn-secondary">{t(locale, "download.selfhost.cta")}</a>
        </p>
      </div>
    </div>
  </section>
</Site>

<style>
  /* One line is reserved for the version and date, which arrive at runtime, so the cards below do not move. */
  .release-line {
    min-height: 1.5rem;
  }
  .side-card {
    display: flex;
    flex-direction: column;
    border: 1px solid var(--color-line);
    border-radius: 0.75rem;
    background: var(--color-bg-1);
    padding: 1.25rem;
  }
  @media (min-width: 48rem) {
    .side-card {
      padding: 1.5rem;
    }
  }
  .side-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: var(--radius-md);
    background: var(--color-bg-3);
    color: var(--color-accent);
  }
  .image {
    overflow-x: auto;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-md);
    background: var(--color-bg-0);
    padding: 0.625rem 0.75rem;
    font-size: 0.875rem;
    color: var(--color-fg-0);
  }
</style>
