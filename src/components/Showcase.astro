---
// SPDX-License-Identifier: Apache-2.0
// A tabbed tour (WAI-ARIA tabs pattern, automatic activation): arrow keys, Home and End move between the tabs,
// the panel swaps its screenshot with a short fade. Without JavaScript every panel is shown one below the other.
import type { SceneKey } from "../assets/screenshots/manifest";
import { t } from "../i18n";
import Shot from "./Shot.astro";

const locale = Astro.currentLocale;
const tabs: { id: string; scene: SceneKey }[] = [
  { id: "chat", scene: "chat-desktop" },
  { id: "voice", scene: "voice-desktop" },
  { id: "polls", scene: "poll-desktop" },
  { id: "files", scene: "files-desktop" },
  { id: "moderation", scene: "roles-desktop" },
  { id: "search", scene: "search-desktop" },
  { id: "apps", scene: "components-desktop" },
];
---

<div class="showcase" data-showcase>
  <div role="tablist" aria-label={t(locale, "tour.tablist")} class="tablist" data-tablist>
    {
      tabs.map((tab, i) => (
        <button
          type="button"
          role="tab"
          id={`tab-${tab.id}`}
          aria-controls={`panel-${tab.id}`}
          aria-selected={i === 0 ? "true" : "false"}
          tabindex={i === 0 ? 0 : -1}
          class="tab"
        >
          {t(locale, `tour.${tab.id}.tab`)}
        </button>
      ))
    }
  </div>
  {
    tabs.map((tab) => (
      <section role="tabpanel" id={`panel-${tab.id}`} aria-labelledby={`tab-${tab.id}`} class="panel" tabindex="0">
        <div class="grid items-center gap-6 lg:grid-cols-[1fr_2.2fr] lg:gap-10">
          <div>
            <h3 class="text-xl font-semibold text-fg-0">{t(locale, `tour.${tab.id}.title`)}</h3>
            <p class="mt-2 text-fg-1">{t(locale, `tour.${tab.id}.text`)}</p>
          </div>
          <Shot scene={tab.scene} sizes="(min-width: 72rem) 46rem, (min-width: 64rem) 66vw, calc(100vw - 2rem)" />
        </div>
      </section>
    ))
  }
</div>

<style>
  .tablist {
    display: none;
  }
  [data-enhanced] .tablist {
    display: flex;
    gap: 0.25rem;
    margin-bottom: 1.5rem;
    padding: 0.25rem;
    overflow-x: auto;
    border: 1px solid var(--color-line);
    border-radius: 999px;
    background: var(--color-bg-1);
    width: fit-content;
    max-width: 100%;
    scrollbar-width: none;
  }
  .tab {
    flex: none;
    min-height: 2.75rem;
    padding: 0 1.125rem;
    border-radius: 999px;
    color: var(--color-fg-1);
    font-size: 0.9375rem;
    font-weight: 500;
    cursor: pointer;
    white-space: nowrap;
  }
  .tab:hover {
    color: var(--color-fg-0);
    background: var(--color-bg-3);
  }
  .tab[aria-selected="true"] {
    background: var(--color-accent);
    color: var(--color-accent-text);
  }
  .tab:focus-visible {
    outline-offset: -2px;
  }
  .panel + .panel {
    margin-top: 3rem;
  }
  [data-enhanced] .panel + .panel {
    margin-top: 0;
  }
  .panel:focus-visible {
    border-radius: 0.75rem;
  }
  @media (prefers-reduced-motion: no-preference) {
    [data-enhanced] .panel.is-entering {
      animation: tour-fade 0.22s ease-out;
    }
  }
  @keyframes tour-fade {
    from {
      opacity: 0;
    }
  }
</style>

<script>
  for (const root of document.querySelectorAll<HTMLElement>("[data-showcase]")) {
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    const panels = tabs.map((tab) => document.getElementById(tab.getAttribute("aria-controls") ?? ""));
    const select = (index: number, focus: boolean) => {
      tabs.forEach((tab, i) => {
        const selected = i === index;
        tab.setAttribute("aria-selected", String(selected));
        tab.tabIndex = selected ? 0 : -1;
        const panel = panels[i];
        if (!panel) return;
        const wasHidden = panel.hidden;
        panel.hidden = !selected;
        if (selected && wasHidden) {
          panel.classList.remove("is-entering");
          void panel.offsetWidth;
          panel.classList.add("is-entering");
        }
      });
      if (focus) tabs[index]?.focus();
    };
    // Load a tab's screenshot as soon as the pointer or the focus comes near it.
    const warm = (i: number) => panels[i]?.querySelectorAll("img").forEach((img) => (img.loading = "eager"));
    tabs.forEach((tab, i) => {
      tab.addEventListener("click", () => select(i, false));
      tab.addEventListener("pointerenter", () => warm(i));
      tab.addEventListener("focus", () => warm(i));
      tab.addEventListener("keydown", (e) => {
        const last = tabs.length - 1;
        const next = { ArrowRight: i === last ? 0 : i + 1, ArrowLeft: i === 0 ? last : i - 1, Home: 0, End: last }[e.key];
        if (next === undefined) return;
        e.preventDefault();
        warm(next);
        select(next, true);
      });
    });
    root.setAttribute("data-enhanced", "");
    select(0, false);
  }
</script>
