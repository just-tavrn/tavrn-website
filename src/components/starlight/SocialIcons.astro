---
// SPDX-License-Identifier: Apache-2.0
// The right side of the docs header: the main sections of the site (the "Status" link with the node's live dot,
// "Report a problem") and the GitHub organization.
import { Icon } from "@astrojs/starlight/components";
import { PUBLIC_GITHUB_ORG } from "astro:env/client";
import { localePath, t } from "../../i18n";
import StatusDot from "../status/StatusDot.astro";

const locale = Astro.currentLocale;
---

<a class="nav" href={localePath(locale, "/download")}>{t(locale, "nav.download")}</a>
<a class="nav" href={localePath(locale, "/status")} data-status-link><StatusDot>{t(locale, "nav.status")}</StatusDot></a>
<a class="nav" href={localePath(locale, "/report")}>{t(locale, "nav.report")}</a>
<a class="icon" href={`https://github.com/${PUBLIC_GITHUB_ORG}`} rel="noopener">
  <span class="sr-only">{t(locale, "nav.github")}</span>
  <Icon name="github" />
</a>

<style>
  a {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    min-height: 2.75rem;
    white-space: nowrap;
    color: var(--sl-color-gray-2);
    text-decoration: none;
    font-size: var(--sl-text-sm);
    font-weight: 500;
  }
  a:hover {
    color: var(--sl-color-white);
  }
  .icon {
    min-width: 2.75rem;
    justify-content: center;
  }
</style>
