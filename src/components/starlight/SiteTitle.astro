---
// SPDX-License-Identifier: Apache-2.0
// The docs header's title: the icon, the brand (translate="no") and "Docs"; links to the landing page.
import { Image } from "astro:assets";
import icon from "../../assets/brand/icon-192.png";

const { siteTitleHref } = Astro.locals.starlightRoute;
---

<a href={siteTitleHref} class="site-title">
  <Image src={icon} alt="" width={32} height={32} densities={[1, 2]} loading="eager" />
  <span><span translate="no">tavrn</span> <span class="docs">Docs</span></span>
</a>

<style>
  .site-title {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    min-height: 2.75rem;
    font-size: var(--sl-text-h4);
    font-weight: 650;
    color: var(--sl-color-white);
    text-decoration: none;
    white-space: nowrap;
    min-width: 0;
  }
  .docs {
    font-weight: 500;
    color: var(--sl-color-gray-2);
  }
  img {
    width: 2rem;
    height: 2rem;
  }
</style>
