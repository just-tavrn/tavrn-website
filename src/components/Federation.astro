---
// SPDX-License-Identifier: Apache-2.0
// "How it works" as an interactive diagram: three nodes with rooms and people. Choosing a node (buttons, or
// tapping/hovering a node in the drawing) shows one idea at a time: an account lives on its home node, a room
// lives on exactly one node, and nodes only exchange signed notifications (the animated dashed line). The text
// below the drawing (aria-live) says the same in words. Without JavaScript the drawing shows the room view and
// the three ideas stay in the cards above it; with reduced motion the line does not move.
import { rich, t } from "../i18n";

const locale = Astro.currentLocale;
const modes = [
  { id: "home", button: t(locale, "fed.button_home"), text: rich(locale, "fed.text_home") },
  { id: "room", button: t(locale, "fed.button_room"), text: rich(locale, "fed.text_room") },
  { id: "notify", button: t(locale, "fed.button_notify"), text: rich(locale, "fed.text_notify") },
] as const;
const initial = "room";
// Domains, room and person names stay untranslated (translate is not in Astro's SVG attribute types).
const keep = { translate: "no" } as Record<string, string>;
---

<div class="federation" data-federation data-mode={initial}>
  <svg viewBox="0 0 520 400" role="img" aria-labelledby="fed-title" class="mx-auto block h-auto w-full max-w-2xl">
    <title id="fed-title">{t(locale, "fed.svg_title")}</title>

    <!-- Clients connect directly to the node of the room. -->
    <g class="layer layer-room" aria-hidden="true">
      <path d="M110 258 L215 132" class="client-line" />
      <path d="M410 258 L305 132" class="client-line" />
      <text x="128" y="186" class="line-label">{t(locale, "fed.label_direct")}</text>
      <text x="392" y="186" class="line-label" text-anchor="end">{t(locale, "fed.label_direct")}</text>
    </g>

    <!-- The only thing nodes send each other: small signed notifications. -->
    <g class="layer layer-notify" aria-hidden="true">
      <path d="M167 315 L353 315" class="notify-line" />
      <rect x="246" y="305" width="28" height="20" rx="3" class="envelope" />
      <path d="M246 306 L260 317 L274 306" class="envelope-flap" />
      <text x="260" y="292" class="line-label" text-anchor="middle">{t(locale, "fed.label_invite")}</text>
    </g>

    <!-- Node of the room (top). -->
    <g class="node" data-node="room">
      <rect x="185" y="20" width="150" height="112" rx="14" class="node-box" />
      <text x="260" y="44" class="node-name" text-anchor="middle" {...keep}>gaming.example</text>
      <rect x="198" y="56" width="124" height="28" rx="7" class="chip chip-room hl-room" />
      <text x="208" y="75" class="chip-text" {...keep}># night-owls</text>
      <circle cx="212" cy="108" r="12" class="person" />
      <text x="212" y="113" class="initial" text-anchor="middle">M</text>
      <text x="230" y="113" class="person-name">Mira</text>
    </g>

    <!-- Alice's home node (bottom left). -->
    <g class="node" data-node="home">
      <rect x="15" y="258" width="152" height="112" rx="14" class="node-box" />
      <text x="91" y="282" class="node-name" text-anchor="middle" {...keep}>example.org</text>
      <circle cx="42" cy="306" r="12" class="person hl-home" />
      <text x="42" y="311" class="initial" text-anchor="middle">A</text>
      <text x="60" y="311" class="person-name">Alice</text>
      <rect x="28" y="328" width="126" height="28" rx="7" class="chip" />
      <text x="38" y="347" class="chip-text" {...keep}># book-club</text>
    </g>

    <!-- Ben's home node (bottom right). -->
    <g class="node" data-node="notify">
      <rect x="353" y="258" width="152" height="112" rx="14" class="node-box" />
      <text x="429" y="282" class="node-name" text-anchor="middle" {...keep}>club.example</text>
      <circle cx="380" cy="306" r="12" class="person hl-notify" />
      <text x="380" y="311" class="initial" text-anchor="middle">B</text>
      <text x="398" y="311" class="person-name">Ben</text>
      <rect x="366" y="328" width="126" height="28" rx="7" class="chip" />
      <text x="376" y="347" class="chip-text" {...keep}># board-games</text>
    </g>

    <g class="layer layer-home" aria-hidden="true">
      <text x="91" y="392" class="address" text-anchor="middle" {...keep}>alice@example.org</text>
    </g>
  </svg>

  <div class="mt-6 flex flex-wrap justify-center gap-2" role="group" aria-label={t(locale, "fed.controls")} data-fed-controls hidden>
    {
      modes.map((m) => (
        <button type="button" class="fed-button" data-mode-button={m.id} aria-pressed={m.id === initial ? "true" : "false"}>
          {m.button}
        </button>
      ))
    }
  </div>
  <p class="mx-auto mt-4 min-h-[4.5rem] max-w-2xl text-center text-fg-1" aria-live="polite" data-fed-text>
    <Fragment set:html={modes.find((m) => m.id === initial)?.text} />
  </p>
  {modes.map((m) => <template data-fed-template={m.id} set:html={m.text} />)}
</div>

<style>
  .node-box {
    fill: var(--color-bg-1);
    stroke: var(--color-line-strong);
    stroke-width: 1.5;
    transition: stroke 0.2s, fill 0.2s;
  }
  .node {
    cursor: pointer;
  }
  .node-name {
    fill: var(--color-fg-0);
    font-size: 15px;
    font-weight: 600;
  }
  .chip {
    fill: var(--color-bg-3);
    stroke: var(--color-line);
    transition: fill 0.2s, stroke 0.2s;
  }
  .chip-text {
    fill: var(--color-fg-1);
    font-size: 14px;
  }
  .person {
    fill: var(--color-bg-3);
    stroke: var(--color-line-strong);
    transition: fill 0.2s, stroke 0.2s;
  }
  .initial {
    fill: var(--color-fg-0);
    font-size: 12px;
    font-weight: 700;
  }
  .person-name {
    fill: var(--color-fg-1);
    font-size: 14px;
  }
  .line-label,
  .address {
    fill: var(--color-accent);
    font-size: 14px;
    font-weight: 600;
  }
  .client-line {
    stroke: var(--color-accent);
    stroke-width: 2.5;
    fill: none;
  }
  .notify-line {
    stroke: var(--color-brand-teal);
    stroke-width: 2.5;
    stroke-dasharray: 8 7;
    fill: none;
  }
  .envelope {
    fill: var(--color-bg-0);
    stroke: var(--color-brand-teal);
    stroke-width: 2;
  }
  .envelope-flap {
    fill: none;
    stroke: var(--color-brand-teal);
    stroke-width: 2;
  }
  .layer {
    opacity: 0;
    transition: opacity 0.3s;
  }
  [data-mode="room"] .layer-room,
  [data-mode="notify"] .layer-notify,
  [data-mode="home"] .layer-home {
    opacity: 1;
  }
  [data-mode="room"] [data-node="room"] .node-box,
  [data-mode="home"] [data-node="home"] .node-box,
  [data-mode="notify"] [data-node="home"] .node-box,
  [data-mode="notify"] [data-node="notify"] .node-box {
    stroke: var(--color-accent);
    fill: color-mix(in srgb, var(--color-accent) 10%, var(--color-bg-1));
  }
  [data-mode="room"] .hl-room,
  [data-mode="home"] .hl-home,
  [data-mode="notify"] .hl-notify {
    fill: var(--color-accent-soft);
    stroke: var(--color-accent);
    stroke-width: 2;
  }
  @media (prefers-reduced-motion: no-preference) {
    [data-mode="notify"] .notify-line {
      animation: fed-dash 0.9s linear infinite;
    }
  }
  @keyframes fed-dash {
    to {
      stroke-dashoffset: -15;
    }
  }
  .fed-button {
    min-height: 2.75rem;
    padding: 0.5rem 1rem;
    border: 1px solid var(--color-line-strong);
    border-radius: 999px;
    background: var(--color-bg-1);
    color: var(--color-fg-0);
    font-size: 0.9375rem;
    font-weight: 500;
    cursor: pointer;
  }
  .fed-button:hover {
    background: var(--color-bg-3);
  }
  .fed-button[aria-pressed="true"] {
    background: var(--color-accent);
    border-color: var(--color-accent);
    color: var(--color-accent-text);
  }
</style>

<script>
  for (const root of document.querySelectorAll<HTMLElement>("[data-federation]")) {
    const text = root.querySelector<HTMLElement>("[data-fed-text]");
    const buttons = [...root.querySelectorAll<HTMLButtonElement>("[data-mode-button]")];
    const controls = root.querySelector<HTMLElement>("[data-fed-controls]");
    const select = (mode: string) => {
      if (root.dataset.mode === mode) return;
      root.dataset.mode = mode;
      for (const b of buttons) b.setAttribute("aria-pressed", String(b.dataset.modeButton === mode));
      const tpl = root.querySelector<HTMLTemplateElement>(`template[data-fed-template="${mode}"]`);
      if (text && tpl) text.replaceChildren(tpl.content.cloneNode(true));
    };
    for (const b of buttons) b.addEventListener("click", () => select(b.dataset.modeButton ?? "room"));
    for (const node of root.querySelectorAll<SVGGElement>("[data-node]")) {
      const mode = node.dataset.node ?? "room";
      node.addEventListener("click", () => select(mode));
      node.addEventListener("pointerenter", (e) => {
        if (e.pointerType === "mouse") select(mode);
      });
    }
    if (controls) controls.hidden = false;
  }
</script>
