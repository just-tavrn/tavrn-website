---
// SPDX-License-Identifier: Apache-2.0
// One operating system on the download page. The card is a static shell (heading, requirements, the "coming later"
// text, the notes): the release is read in the browser at runtime, and the script of Releases.astro fills the
// installers of the selected channel into it from the templates at the end, or shows "coming later" while the
// release has none for this system. Windows lists the Tauri app first and the optional Electron build, when the
// release has one, in a small secondary disclosure; Linux is the Electron shell only. While the repository is
// private the files are listed without download links. The card carries data-os-card so the script can move the
// visitor's system to the front.
import { rich, t } from "../../i18n";
import Verify from "./Verify.astro";

export type CardKey = "windows" | "linux" | "macos" | "mobile";

interface Props {
  card: CardKey;
}

const { card } = Astro.props;
const locale = Astro.currentLocale;
const headingId = `os-${card}`;
---

<li class="os-card" data-os-card={card}>
  <div class="flex flex-wrap items-center gap-x-3 gap-y-1">
    <span class="os-icon" aria-hidden="true"><slot name="icon" /></span>
    <h3 id={headingId} class="text-xl font-semibold text-fg-0">{t(locale, `download.${card}.title`)}</h3>
    <span class="recommended" data-recommended-badge hidden>{t(locale, "download.recommended")}</span>
    <span class="beta-badge" data-beta-badge hidden>{t(locale, "download.beta_badge")}</span>
  </div>
  <p class="mt-1 text-sm text-fg-2">{t(locale, `download.${card}.requirements`)}</p>

  <div class="dl-slot" data-dl-slot>
    <ul class="mt-5 flex flex-col gap-2.5" data-dl-list></ul>
    <div class="flex flex-col" data-later hidden>
      <p class="mt-5 self-start rounded-full border border-line px-3 py-1 text-sm font-medium text-fg-1">{t(locale, "download.coming_later")}</p>
      <p class="mt-3 text-fg-1" set:html={rich(locale, `download.${card}.later`)} />
    </div>
    {card === "linux" && <p class="mt-3 text-sm text-fg-1" data-linux-note hidden>{t(locale, "download.linux.electron")}</p>}
    {
      card === "windows" && (
        <details class="alt mt-4" data-alt-build hidden>
          <summary>{t(locale, "download.windows.alt_summary")}</summary>
          <p class="mt-1">{t(locale, "download.windows.alt_text")}</p>
          <ul class="mt-2 flex flex-col gap-1" data-alt-list />
        </details>
      )
    }
  </div>

  <Verify card={card} />

  <template data-tpl-download>
    <li>
      <a class="btn dl-button" download><span class="dl-label"></span><span class="dl-meta"></span></a>
    </li>
  </template>
  <template data-tpl-file>
    <li class="dl-file">
      <span class="dl-label"></span><span class="dl-meta"></span>
    </li>
  </template>
  {
    card === "windows" && (
      <template data-tpl-alt>
        <li>
          <a class="link" download /><span class="dl-alt-label" /><span class="text-fg-2" />
        </li>
      </template>
    )
  }
</li>

<style>
  .os-card {
    display: flex;
    flex-direction: column;
    border: 1px solid var(--color-line);
    border-radius: 0.75rem;
    background: var(--color-bg-1);
    padding: 1.25rem;
  }
  @media (min-width: 48rem) {
    .os-card {
      padding: 1.5rem;
    }
  }
  .os-card[data-recommended="true"] {
    border-color: var(--color-accent);
    box-shadow: 0 0 0 1px var(--color-accent-soft);
  }
  .os-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: var(--radius-md);
    background: var(--color-bg-3);
    color: var(--color-accent);
  }
  .recommended {
    border-radius: 999px;
    background: var(--color-accent-soft);
    color: var(--color-fg-0);
    padding: 0.125rem 0.625rem;
    font-size: 0.8125rem;
    font-weight: 600;
  }
  .beta-badge {
    border: 1px solid var(--color-warn);
    border-radius: 999px;
    color: var(--color-fg-0);
    padding: 0.0625rem 0.5625rem;
    font-size: 0.8125rem;
    font-weight: 600;
  }
  .recommended[hidden],
  .beta-badge[hidden] {
    display: none;
  }
  /* While the release list loads, each card keeps about the height it has with a release (installers for Windows and
     Linux, "coming later" for the others), so the page does not jump when they arrive. */
  :global([data-releases][data-state="loading"]) .os-card[data-os-card="windows"] {
    min-height: 23.6rem;
  }
  :global([data-releases][data-state="loading"]) .os-card[data-os-card="linux"] {
    min-height: 25.3rem;
  }
  :global([data-releases][data-state="loading"]) .os-card[data-os-card="macos"] {
    min-height: 15rem;
  }
  :global([data-releases][data-state="loading"]) .os-card[data-os-card="mobile"] {
    min-height: 18.25rem;
  }
  @media (min-width: 48rem) {
    :global([data-releases][data-state="loading"]) .os-card[data-os-card="windows"] {
      min-height: 23rem;
    }
    :global([data-releases][data-state="loading"]) .os-card[data-os-card="linux"] {
      min-height: 22.5rem;
    }
    :global([data-releases][data-state="loading"]) .os-card[data-os-card="macos"] {
      min-height: 14rem;
    }
    :global([data-releases][data-state="loading"]) .os-card[data-os-card="mobile"] {
      min-height: 15.5rem;
    }
  }
  .dl-file {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.25rem 0.75rem;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-md);
    padding: 0.625rem 0.875rem;
    color: var(--color-fg-0);
  }
  .dl-file .dl-label {
    font-weight: 600;
  }
  .dl-button {
    width: 100%;
    flex-wrap: wrap;
    justify-content: space-between;
    text-align: left;
    gap: 0.25rem 0.75rem;
  }
  .dl-meta {
    font-weight: 500;
    font-size: 0.8125rem;
    opacity: 0.85;
  }
  .alt {
    color: var(--color-fg-1);
    font-size: 0.875rem;
    line-height: 1.55;
  }
  .alt summary {
    display: flex;
    align-items: center;
    min-height: 2.75rem;
    cursor: pointer;
    color: var(--color-fg-1);
    text-decoration: underline;
    text-decoration-color: var(--color-line-strong);
    text-underline-offset: 3px;
  }
  .alt summary:hover {
    color: var(--color-fg-0);
  }
  .alt li a {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
  }
</style>
