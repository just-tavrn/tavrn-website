---
// SPDX-License-Identifier: Apache-2.0
// One operating system on the download page: its installers from downloads.json (disabled while the data is the
// committed example), or "coming later" while the release has none for it, plus the verification notes. Windows
// lists the Tauri app first and the optional Electron build, when the release has one, in a small secondary
// disclosure; Linux is the Electron shell only. The card carries data-os-card so the page's script can move the
// visitor's system to the front.
import type { DownloadAsset } from "../../lib/releases";
import { formatSize } from "../../lib/releases";
import { rich, t } from "../../i18n";
import Verify from "./Verify.astro";

export type CardKey = "windows" | "linux" | "macos" | "mobile";

interface Props {
  card: CardKey;
  assets: DownloadAsset[];
  example: boolean;
}

const { card, assets, example } = Astro.props;
// Windows: the Tauri installers are the app; an Electron build (for WebView2 trouble) is the alternative.
const main = card === "windows" ? assets.filter((a) => a.shell === "tauri") : assets;
const alternatives = card === "windows" ? assets.filter((a) => a.shell === "electron") : [];
const locale = Astro.currentLocale;
const headingId = `os-${card}`;
const describe = (a: DownloadAsset) => [a.arch ? t(locale, `download.arch.${a.arch}`) : null, formatSize(a.size, locale)].filter(Boolean).join(" · ");
---

<li class="os-card" data-os-card={card}>
  <div class="flex flex-wrap items-center gap-x-3 gap-y-1">
    <span class="os-icon" aria-hidden="true"><slot name="icon" /></span>
    <h3 id={headingId} class="text-xl font-semibold text-fg-0">{t(locale, `download.${card}.title`)}</h3>
    <span class="recommended" data-recommended-badge hidden>{t(locale, "download.recommended")}</span>
  </div>
  <p class="mt-1 text-sm text-fg-2">{t(locale, `download.${card}.requirements`)}</p>

  {
    main.length > 0 ? (
      <ul class="mt-5 flex flex-col gap-2.5">
        {main.map((a, i) => (
          <li>
            {example ? (
              <button type="button" class:list={["btn dl-button", i === 0 ? "btn-primary" : "btn-secondary"]} disabled>
                <span class="dl-label">{t(locale, `download.kind.${a.kind}`)}</span>
                <span class="dl-meta">{describe(a)}</span>
                <span class="sr-only">{t(locale, "download.unavailable_sr")}</span>
              </button>
            ) : (
              <a href={a.url} class:list={["btn dl-button", i === 0 ? "btn-primary" : "btn-secondary"]} download>
                <span class="dl-label">{t(locale, `download.kind.${a.kind}`)}</span>
                <span class="dl-meta">{describe(a)}</span>
              </a>
            )}
          </li>
        ))}
      </ul>
    ) : (
      <>
        <p class="mt-5 self-start rounded-full border border-line px-3 py-1 text-sm font-medium text-fg-1">{t(locale, "download.coming_later")}</p>
        <p class="mt-3 text-fg-1" set:html={rich(locale, `download.${card}.later`)} />
      </>
    )
  }

  {card === "linux" && main.length > 0 && <p class="mt-3 text-sm text-fg-1">{t(locale, "download.linux.electron")}</p>}

  {
    alternatives.length > 0 && (
      <details class="alt mt-4" data-alt-build>
        <summary>{t(locale, "download.windows.alt_summary")}</summary>
        <p class="mt-1">{t(locale, "download.windows.alt_text")}</p>
        <ul class="mt-2 flex flex-col gap-1">
          {alternatives.map((a) => (
            <li>
              {example ? (
                <span>
                  {t(locale, "download.windows.alt_item", { kind: t(locale, `download.kind.${a.kind}`) })}
                  <span class="text-fg-2"> · {describe(a)}</span>
                  <span class="sr-only"> {t(locale, "download.unavailable_sr")}</span>
                </span>
              ) : (
                <>
                  <a class="link" href={a.url} download>
                    {t(locale, "download.windows.alt_item", { kind: t(locale, `download.kind.${a.kind}`) })}
                  </a>
                  <span class="text-fg-2"> · {describe(a)}</span>
                </>
              )}
            </li>
          ))}
        </ul>
      </details>
    )
  }

  {assets.length > 0 && <Verify card={card} assets={[...main, ...alternatives]} />}
</li>

<style>
  .os-card {
    display: flex;
    flex-direction: column;
    border: 1px solid var(--color-line);
    border-radius: 0.75rem;
    background: var(--color-bg-1);
    padding: 1.25rem;
  }
  @media (min-width: 48rem) {
    .os-card {
      padding: 1.5rem;
    }
  }
  .os-card[data-recommended="true"] {
    border-color: var(--color-accent);
    box-shadow: 0 0 0 1px var(--color-accent-soft);
  }
  .os-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: var(--radius-md);
    background: var(--color-bg-3);
    color: var(--color-accent);
  }
  .recommended {
    border-radius: 999px;
    background: var(--color-accent-soft);
    color: var(--color-fg-0);
    padding: 0.125rem 0.625rem;
    font-size: 0.8125rem;
    font-weight: 600;
  }
  .recommended[hidden] {
    display: none;
  }
  .dl-button {
    width: 100%;
    flex-wrap: wrap;
    justify-content: space-between;
    text-align: left;
    gap: 0.25rem 0.75rem;
  }
  .dl-meta {
    font-weight: 500;
    font-size: 0.8125rem;
    opacity: 0.85;
  }
  .alt {
    color: var(--color-fg-1);
    font-size: 0.875rem;
    line-height: 1.55;
  }
  .alt summary {
    display: flex;
    align-items: center;
    min-height: 2.75rem;
    cursor: pointer;
    color: var(--color-fg-1);
    text-decoration: underline;
    text-decoration-color: var(--color-line-strong);
    text-underline-offset: 3px;
  }
  .alt summary:hover {
    color: var(--color-fg-0);
  }
  .alt li a {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
  }
  .dl-button:disabled {
    cursor: not-allowed;
    opacity: 0.55;
  }
  .btn-primary:disabled:hover {
    background: var(--color-accent);
  }
  .btn-secondary:disabled:hover {
    background: var(--color-bg-1);
  }
</style>
