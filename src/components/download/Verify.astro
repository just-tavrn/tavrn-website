---
// SPDX-License-Identifier: Apache-2.0
// "Verify the download" of an operating system card: the SHA-256 of every file (GitHub's digest) with the command
// that computes it on that system, the notes on the updaters (Tauri's signatures, electron-updater's feed), and what
// the system says about unsigned builds. A static shell: the script of Releases.astro fills in the files of the
// selected release and shows the notes that apply to it.
import { t } from "../../i18n";
import type { CardKey } from "./OsCard.astro";

interface Props {
  card: CardKey;
}

const { card } = Astro.props;
const locale = Astro.currentLocale;
const system = card === "mobile" ? "android" : card;
---

<details class="verify mt-5" data-verify data-system={system} hidden>
  <summary>{t(locale, "download.verify.summary")}</summary>
  <div class="verify-body">
    <p>{t(locale, "download.verify.checksum_intro")}</p>
    <dl class="sums" data-sums></dl>
    <template data-tpl-sum>
      <div>
        <dt><code translate="no"></code></dt>
        <dd><code translate="no" class="hash"></code><span class="text-fg-2" hidden>{t(locale, "download.verify.checksum_missing")}</span></dd>
      </div>
    </template>
    <p>{t(locale, `download.verify.how_${system}`)}</p>
    <pre><code translate="no" data-command></code></pre>
    <p><a class="link" href="#verify">{t(locale, "download.verify.check_here")}</a></p>
    <p data-signature-note hidden>{t(locale, "download.verify.signature")}</p>
    {(system === "linux" || system === "windows") && <p data-electron-note hidden>{t(locale, `download.verify.electron_feed_${system}`)}</p>}
    <p>{t(locale, `download.verify.unsigned_${system}`)}</p>
    {system === "linux" && <pre data-chmod hidden><code translate="no" /></pre>}
  </div>
</details>

<style>
  .verify {
    border-top: 1px solid var(--color-line);
    padding-top: 0.75rem;
  }
  summary {
    display: flex;
    align-items: center;
    min-height: 2.75rem;
    cursor: pointer;
    color: var(--color-fg-0);
    font-weight: 600;
    font-size: 0.9375rem;
  }
  .verify-body {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding-bottom: 0.25rem;
    color: var(--color-fg-1);
    font-size: 0.9375rem;
    line-height: 1.6;
  }
  .sums {
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
  }
  dt code {
    color: var(--color-fg-0);
    font-size: 0.8125rem;
    overflow-wrap: anywhere;
  }
  .hash {
    display: block;
    font-size: 0.75rem;
    color: var(--color-fg-1);
    overflow-wrap: anywhere;
  }
  pre[hidden] {
    display: none;
  }
  /* Commands wrap instead of scrolling (file names of betas are long): a scrolling region would need a Tab stop. */
  pre {
    white-space: pre-wrap;
    overflow-wrap: anywhere;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-md);
    background: var(--color-bg-0);
    padding: 0.625rem 0.75rem;
    font-size: 0.8125rem;
    color: var(--color-fg-0);
  }
</style>
