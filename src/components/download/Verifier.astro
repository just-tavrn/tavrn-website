---
// SPDX-License-Identifier: Apache-2.0
// The checksum verifier of the download page, rendered once below the cards (each card's "Verify the download"
// links here): a labelled file input with a drop zone and an optional "expected checksum" field. The script reads the
// file on the visitor's device, computes SHA-256 (and SHA-512 for a pasted SHA-512, or when the known checksums list
// one) with crypto.subtle and compares it with the known checksums of the selected release and with a pasted value.
// The known checksums arrive at runtime: Releases.astro writes them into data-known (GitHub's SHA-256 digests of the
// shown release) and fires "known-change". Nothing is uploaded. Plain JavaScript (src/lib/verify.ts holds the pure
// part).
import Lock from "@lucide/astro/icons/lock";
import ShieldCheck from "@lucide/astro/icons/shield-check";
import { t } from "../../i18n";

const locale = Astro.currentLocale;
const keys = [
  "computing", "file", "match_asset", "match_pasted", "mismatch_pasted", "invalid_pasted", "no_match", "no_match_listed",
  "computed", "too_large", "read_error", "unsupported", "copy", "copied",
];
const strings = Object.fromEntries(keys.map((k) => [k, t(locale, `download.verifier.${k}`)]));
---

<section id="verify" class="container-site pb-12" aria-labelledby="verify-title">
  <div class="verifier" data-verifier data-known="[]" data-strings={JSON.stringify(strings)} data-locale={locale ?? "en"}>
    <div class="flex items-center gap-3">
      <span class="v-icon" aria-hidden="true"><ShieldCheck class="h-5 w-5" /></span>
      <h2 id="verify-title" class="text-xl font-semibold text-fg-0">{t(locale, "download.verifier.title")}</h2>
    </div>
    <p class="mt-3 max-w-3xl text-fg-1">{t(locale, "download.verifier.lead")}</p>
    <p class="private mt-2" id="verify-private">
      <Lock class="h-4 w-4 shrink-0" aria-hidden="true" />
      {t(locale, "download.verifier.private")}
    </p>
    <p class="mt-4 text-fg-1" data-verifier-nojs>{t(locale, "download.verifier.nojs")}</p>

    <div class="mt-5 grid gap-5 md:grid-cols-2" data-verifier-ui hidden>
      <div class="drop" data-drop>
        <input type="file" id="verify-file" class="file-input" aria-describedby="verify-private" data-file />
        <label for="verify-file" class="btn btn-secondary">{t(locale, "download.verifier.choose")}</label>
        <span class="text-sm text-fg-2">{t(locale, "download.verifier.drop")}</span>
      </div>
      <div class="flex flex-col">
        <label for="verify-expected" class="text-sm font-semibold text-fg-0">{t(locale, "download.verifier.expected_label")}</label>
        <p id="verify-expected-hint" class="mt-0.5 text-sm text-fg-2">{t(locale, "download.verifier.expected_hint")}</p>
        <input
          id="verify-expected"
          type="text"
          class="field mt-2"
          autocomplete="off"
          autocapitalize="off"
          spellcheck="false"
          translate="no"
          aria-describedby="verify-expected-hint"
          data-expected
        />
      </div>
      <div class="result md:col-span-2" aria-live="polite" data-result></div>
    </div>

    <div class="notes mt-5">
      <p>{t(locale, "download.verifier.proves")}</p>
      <p>{t(locale, "download.verifier.limits")}</p>
    </div>
  </div>
</section>

<style>
  .verifier {
    border: 1px solid var(--color-line);
    border-radius: 0.75rem;
    background: var(--color-bg-1);
    padding: 1.25rem;
  }
  @media (min-width: 48rem) {
    .verifier {
      padding: 1.5rem;
    }
  }
  .v-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: var(--radius-md);
    background: var(--color-bg-3);
    color: var(--color-accent);
  }
  .private {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--color-fg-0);
    font-size: 0.9375rem;
    font-weight: 500;
  }
  [data-verifier-ui][hidden],
  [data-verifier-nojs][hidden] {
    display: none;
  }
  .drop {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    min-height: 8rem;
    border: 2px dashed var(--color-line-strong);
    border-radius: 0.75rem;
    padding: 1rem;
    text-align: center;
  }
  .drop[data-over="true"] {
    border-color: var(--color-accent);
    background: var(--color-accent-soft);
  }
  /* The real input stays in the Tab order (its label is the visible button); the focus ring moves to the label. */
  .file-input {
    position: absolute;
    width: 1px;
    height: 1px;
    opacity: 0;
    overflow: hidden;
  }
  .file-input:focus-visible + label {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }
  .file-input:disabled + label {
    cursor: progress;
    opacity: 0.6;
  }
  label.btn {
    cursor: pointer;
  }
  .field {
    min-height: 2.75rem;
    border: 1px solid var(--color-line-strong);
    border-radius: var(--radius-md);
    background: var(--color-bg-0);
    padding: 0.5rem 0.75rem;
    color: var(--color-fg-0);
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    font-size: 0.875rem;
  }
  .result:empty {
    display: none;
  }
  .result {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-md);
    background: var(--color-bg-0);
    padding: 0.875rem 1rem;
    color: var(--color-fg-1);
    overflow-wrap: anywhere;
  }
  .result :global(.v-line) {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    color: var(--color-fg-0);
    font-weight: 600;
  }
  .result :global(.v-line::before) {
    content: "";
    flex: none;
    width: 0.625rem;
    height: 0.625rem;
    border-radius: 999px;
    background: var(--color-line-strong);
    transform: translateY(-0.05rem);
  }
  .result :global(.v-line[data-tone="ok"]::before) {
    background: var(--color-ok);
  }
  .result :global(.v-line[data-tone="bad"]::before) {
    background: var(--color-danger);
  }
  .result :global(.v-line[data-tone="warn"]::before) {
    background: var(--color-warn);
  }
  .result :global(.v-file) {
    color: var(--color-fg-1);
    font-size: 0.875rem;
  }
  .result :global(.v-hash) {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
  }
  .result :global(.v-hash code) {
    color: var(--color-fg-0);
    font-size: 0.8125rem;
    overflow-wrap: anywhere;
  }
  .result :global(.v-copy) {
    min-height: 2.75rem;
    padding: 0.375rem 0.875rem;
    font-size: 0.875rem;
  }
  .notes {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
    max-width: 52rem;
    color: var(--color-fg-2);
    font-size: 0.875rem;
    line-height: 1.6;
  }
</style>

<script>
  // Reads the chosen or dropped file on this device, computes its digests and compares them. No network at all.
  import { formatSize } from "../../lib/releases";
  import {
    type Algo,
    algoLabel,
    bytesToHex,
    type Digests,
    findMatch,
    type KnownFile,
    MAX_BYTES,
    matchesExpected,
    needsSha512,
    normalizeChecksum,
  } from "../../lib/verify";

  const root = document.querySelector<HTMLElement>("[data-verifier]");
  if (root) {
    // The known checksums of the release the page shows; Releases.astro replaces them when it loads or switches.
    const known = () => {
      try {
        return JSON.parse(root.dataset.known ?? "[]") as KnownFile[];
      } catch {
        return [];
      }
    };
    const strings = JSON.parse(root.dataset.strings ?? "{}") as Record<string, string>;
    const locale = root.dataset.locale ?? "en";
    const input = root.querySelector<HTMLInputElement>("[data-file]")!;
    const expected = root.querySelector<HTMLInputElement>("[data-expected]")!;
    const result = root.querySelector<HTMLElement>("[data-result]")!;
    const drop = root.querySelector<HTMLElement>("[data-drop]")!;
    root.querySelector("[data-verifier-ui]")?.removeAttribute("hidden");
    root.querySelector("[data-verifier-nojs]")?.setAttribute("hidden", "");

    const s = (key: string, params: Record<string, string> = {}) =>
      (strings[key] ?? key).replace(/\{(\w+)\}/g, (whole, name: string) => params[name] ?? whole);
    const el = (tag: string, cls: string, text?: string) => {
      const node = document.createElement(tag);
      if (cls) node.className = cls;
      if (text !== undefined) node.textContent = text;
      return node;
    };
    const line = (tone: "ok" | "bad" | "warn" | "info", text: string) => {
      const p = el("p", "v-line", text);
      p.dataset.tone = tone;
      return p;
    };
    const hashRow = (label: string, hex: string) => {
      const row = el("div", "v-hash");
      if (label) row.append(el("span", "", label));
      const code = el("code", "", hex);
      code.setAttribute("translate", "no");
      const copy = el("button", "btn btn-secondary v-copy", s("copy")) as HTMLButtonElement;
      copy.type = "button";
      copy.addEventListener("click", async () => {
        try {
          await navigator.clipboard.writeText(hex);
          copy.textContent = s("copied");
        } catch {
          getSelection()?.selectAllChildren(code);
        }
      });
      row.append(code, copy);
      return row;
    };

    let current: { file: File; digests: Digests } | null = null;
    let busy = false;

    const digest = async (algo: Algo, data: ArrayBuffer) =>
      bytesToHex(await crypto.subtle.digest(algo === "sha256" ? "SHA-256" : "SHA-512", data));

    function render(): void {
      if (!current) return;
      const { file, digests } = current;
      const nodes: Node[] = [el("p", "v-file", s("file", { name: file.name, size: formatSize(file.size, locale) }))];
      const pastedText = expected.value.trim();
      const pasted = pastedText ? normalizeChecksum(pastedText) : null;
      let pastedMatch = false;
      if (pastedText && !pasted) nodes.push(line("warn", s("invalid_pasted")));
      if (pasted) {
        pastedMatch = matchesExpected(pasted, digests);
        if (pastedMatch) nodes.push(line("ok", s("match_pasted", { algo: algoLabel(pasted.algo) })));
        else {
          nodes.push(line("bad", s("mismatch_pasted", { algo: algoLabel(pasted.algo) })));
          const hex = pasted.algo === "sha256" ? digests.sha256 : digests.sha512;
          if (hex) nodes.push(hashRow(s("computed", { algo: algoLabel(pasted.algo) }), hex));
        }
      }
      const match = findMatch(known(), digests);
      if (match) nodes.push(line("ok", s("match_asset", { name: match.name, algo: algoLabel(match.algo) })));
      else if (pasted && !pastedMatch) nodes.push(line("info", s("no_match_listed")));
      else if (!pastedMatch) nodes.push(line("bad", s("no_match")), hashRow("", digests.sha256));
      result.replaceChildren(...nodes);
    }

    async function check(file: File): Promise<void> {
      if (busy) return;
      if (file.size > MAX_BYTES) {
        current = null;
        result.replaceChildren(line("warn", s("too_large", { name: file.name })));
        return;
      }
      if (!globalThis.crypto?.subtle) {
        result.replaceChildren(line("warn", s("unsupported")));
        return;
      }
      busy = true;
      input.disabled = true;
      result.replaceChildren(line("info", s("computing", { name: file.name })));
      try {
        const data = await file.arrayBuffer();
        const pasted = normalizeChecksum(expected.value);
        const digests: Digests = { sha256: await digest("sha256", data) };
        if (needsSha512(known()) || pasted?.algo === "sha512") digests.sha512 = await digest("sha512", data);
        current = { file, digests };
        render();
      } catch {
        current = null;
        result.replaceChildren(line("warn", s("read_error", { name: file.name })));
      } finally {
        busy = false;
        input.disabled = false;
      }
    }

    root.addEventListener("known-change", () => {
      if (current && !busy) render();
    });
    input.addEventListener("change", () => {
      const file = input.files?.[0];
      if (file) void check(file);
    });
    // A pasted value is compared right away; a SHA-512 that was not computed yet needs the file read once more.
    expected.addEventListener("input", () => {
      if (!current || busy) return;
      const pasted = normalizeChecksum(expected.value);
      if (pasted?.algo === "sha512" && !current.digests.sha512) void check(current.file);
      else render();
    });
    drop.addEventListener("dragover", (e) => {
      e.preventDefault();
      drop.dataset.over = "true";
    });
    drop.addEventListener("dragleave", () => delete drop.dataset.over);
    drop.addEventListener("drop", (e) => {
      e.preventDefault();
      delete drop.dataset.over;
      const file = e.dataTransfer?.files?.[0];
      if (file) void check(file);
    });
  }
</script>
